# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.htaccess text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
