# ============================================================
# Bachat — Apache configuration (InfinityFree compatible)
# ============================================================

Options -Indexes

# ---------- Protect non-public files ----------
RewriteEngine On
# RewriteBase / (Commented out to support running in subfolder like /Bachat-php/ or root)

# Block direct access to application internals
RewriteRule ^app/ - [F,L]
RewriteRule ^database\.sql$ - [F,L]
RewriteRule ^README\.md$ - [F,L]
RewriteRule ^\.git - [F,L]

# ---------- Front controller ----------
# If mod_rewrite is unavailable, the app also supports ?r=/path URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ---------- Security headers ----------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- Gzip compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching for static assets ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# ---------- Character set ----------
AddDefaultCharset UTF-8
